# Copy to .env and fill in. Secrets live only here, never in code or configs.

# App config file (overridden in docker-compose)
APP_CONFIG=configs/base.yaml

# Exposes the /dev test page. Never enable in production.
DEV_MODE=true

# Commercial provider API keys (needed once commercial providers are used)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# Redis (sessions)
REDIS_URL=redis://redis:6379/0
